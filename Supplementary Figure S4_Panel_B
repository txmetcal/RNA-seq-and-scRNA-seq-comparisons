
# ============================================================
# Supplementary Figure S4B
# RNA UMAP labeled by Seurat cluster
#
# Dataset: GEO GSE293459
# Cell population: All cells in original Seurat object
# ============================================================

# Use original full patient dataset (obj)
# Do NOT use the epithelial subset (epi) for this panel.

p_S4B <- DimPlot(
  object = obj,
  reduction = "rnaumap",
  group.by = "seurat_clusters",
  label = TRUE,
  repel = FALSE,
  pt.size = 0.25,
  raster = FALSE
) +
  ggtitle("RNA UMAP labeled by cluster") +
  theme_classic()

# Display figure
print(p_S4B)

